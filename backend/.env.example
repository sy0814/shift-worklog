# 复制为 .env 后修改
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL 示例：postgresql+psycopg://app:app@db:5432/workrecord
SECRET_KEY=change-me-to-a-long-random-string
APP_TIMEZONE=Europe/Belgrade
ACCESS_TOKEN_HOURS=12
# 首次启动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# DeepSeek（翻译 / AI 分析）。Key 不要提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_EXTRA_BODY={"thinking": {"type": "disabled"}}
UPLOAD_DIR=./data/uploads
# 第一次启动时建示例班组（1～4 班、常白班）和 7 个班长账号（密码同用户名），开发 / 试用时设 true；正式使用保持 false
SEED_DEMO=false
